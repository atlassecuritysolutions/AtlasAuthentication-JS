{
    "name": "atlas-auth-console-example",
    "version": "1.0.0",
    "description": "Atlas SDK - Node console example, packageable as a Windows .exe.",
    "main": "Atlas Auth Example.js",
    "private": true,
    "bin": "Atlas Auth Example.js",
    "os": ["win32"],
    "cpu": ["x64"],
    "engines": { "node": ">=18" },
    "scripts": {
        "start":     "node \"Atlas Auth Example.js\"",
        "build:exe": "pkg . --targets node22-win-x64 --output \"../../../../- Builds/Atlas Auth Example (JS).exe\""
    },
    "pkg": {
        "assets": [
            "../Atlas SDK/src/index.js",
            "../Atlas SDK/src/index.d.ts",
            "../Atlas SDK/package.json",
            "../Atlas SDK/Atlas.dll"
        ],
        "targets": ["node22-win-x64"]
    },
    "devDependencies": {
        "@yao-pkg/pkg": "^6.6.0"
    },
    "dependencies": {
        "koffi": "^2.9.0"
    }
}
